# MongoDB Database Configuration
# Get your connection string from MongoDB Atlas
# Replace <db_password> with your database password
# IMPORTANT: If your password contains special characters, URL encode them:
#   @ -> %40
#   # -> %23
#   : -> %3A
#   / -> %2F
#   ? -> %3F
#   & -> %26
#   = -> %3D
# Example: If password is "pass@word", use "pass%40word"
DATABASE_URL="mongodb+srv://ronak:<db_password>@cluster0.shf37pg.mongodb.net/quickdocs?retryWrites=true&w=majority&appName=Cluster0"

# NextAuth.js Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# For production on Vercel, set NEXTAUTH_URL to your production URL:
# NEXTAUTH_URL="https://your-app.vercel.app"

# NOWPayments Configuration
# Get your API key from https://nowpayments.io
# Use sandbox API for testing: https://sandbox.nowpayments.io
NOWPAYMENTS_API_KEY="your-nowpayments-api-key-here"
NOWPAYMENTS_IPN_SECRET="your-ipn-secret-here"
NOWPAYMENTS_WEBHOOK_URL="https://your-domain.vercel.app/api/webhooks/nowpayments"
