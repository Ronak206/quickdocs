// DocuForge Pro - Enterprise PDF Generation Platform
// Prisma Schema for Document Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  company       String?
  logo          String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  taxId         String?
  website       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  documents     Document[]
  templates     Template[]
  activities    Activity[]
}

// ============================================
// Template Models
// ============================================

model Template {
  id            String           @id @default(cuid())
  name          String
  description   String?
  category      TemplateCategory
  type          DocumentType
  schema        String           // JSON schema for form fields
  layout        String           // JSON layout definition
  styling       String?          // Custom CSS/styles
  preview       String?          // Preview image URL
  thumbnail     String?          // Thumbnail image URL
  isPublic      Boolean          @default(false)
  isPremium     Boolean          @default(false)
  isDefault     Boolean          @default(false)
  source        String?          // URL if from external source
  sourceName    String?          // Name of external source
  tags          String?          // Comma-separated tags
  version       Int              @default(1)
  downloads     Int              @default(0)
  rating        Float?           // Average rating
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  // Relations
  creatorId     String?
  creator       User?            @relation(fields: [creatorId], references: [id])
  documents     Document[]
  fields        TemplateField[]
}

model TemplateField {
  id            String        @id @default(cuid())
  templateId    String
  template      Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  label         String
  type          FieldType
  required      Boolean       @default(false)
  defaultValue  String?
  placeholder   String?
  helpText      String?
  options       String?       // JSON for select/radio options
  validation    String?       // Validation rules
  order         Int           @default(0)
  group         String?       // Field group name
  width         String?       // Field width (full, half, third)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============================================
// Document Models
// ============================================

model Document {
  id            String          @id @default(cuid())
  title         String
  documentNumber String?        @unique
  type          DocumentType
  data          String          // JSON document data
  templateId    String?
  template      Template?       @relation(fields: [templateId], references: [id])
  ownerId       String
  owner         User            @relation(fields: [ownerId], references: [id])
  status        DocumentStatus  @default(draft)
  pdfUrl        String?
  pdfGeneratedAt DateTime?
  totalAmount   Float?          // For invoices/expenses
  currency      String?         @default("USD")
  validFrom     DateTime?
  validTo       DateTime?
  notes         String?
  tags          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relations
  items         DocumentItem[]
  history       DocumentHistory[]
  activities    Activity[]
}

model DocumentItem {
  id            String     @id @default(cuid())
  documentId    String
  document      Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  quantity      Float      @default(1)
  unitPrice     Float      @default(0)
  total         Float      @default(0)
  taxRate       Float?     @default(0)
  taxAmount     Float?     @default(0)
  category      String?
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DocumentHistory {
  id            String        @id @default(cuid())
  documentId    String
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action        String
  changes       String?       // JSON of changes made
  previousState String?       // JSON of previous state
  userId        String?
  userName      String?
  createdAt     DateTime      @default(now())
}

// ============================================
// Activity & Analytics Models
// ============================================

model Activity {
  id            String      @id @default(cuid())
  type          ActivityType
  description   String
  metadata      String?     // JSON additional data
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  documentId    String?
  document      Document?   @relation(fields: [documentId], references: [id])
  createdAt     DateTime    @default(now())
}

// ============================================
// Enums
// ============================================

enum TemplateCategory {
  EXPENSE
  TENDER
  PROPOSAL
  SALARY
  INVOICE
  RECEIPT
  CONTRACT
  REPORT
  LETTER
  CERTIFICATE
  AGREEMENT
  QUOTE
  MEMO
  CUSTOM
}

enum DocumentType {
  // Expense Types
  EXPENSE_REPORT
  EXPENSE_CLAIM
  TRAVEL_EXPENSE
  MONTHLY_EXPENSE
  
  // Tender Types
  TENDER_DOCUMENT
  TENDER_PROPOSAL
  BID_DOCUMENT
  TENDER_EVALUATION
  RFP_DOCUMENT
  
  // Proposal Types
  BUSINESS_PROPOSAL
  PROJECT_PROPOSAL
  SALES_PROPOSAL
  PARTNERSHIP_PROPOSAL
  GRANT_PROPOSAL
  
  // Salary Types
  SALARY_SLIP
  SALARY_CERTIFICATE
  PAYROLL_REPORT
  SALARY_INCREMENT
  OFFER_LETTER
  
  // Invoice & Receipt
  INVOICE
  PROFORMA_INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  
  // Contract & Agreement
  CONTRACT
  AGREEMENT
  NDA
  SERVICE_AGREEMENT
  
  // Other
  REPORT
  LETTER
  CERTIFICATE
  QUOTE
  MEMO
  CUSTOM
}

enum DocumentStatus {
  draft
  pending_review
  approved
  rejected
  sent
  paid
  overdue
  cancelled
  archived
}

enum FieldType {
  text
  number
  email
  phone
  date
  datetime
  textarea
  select
  radio
  checkbox
  currency
  percentage
  file
  image
  signature
  company
  address
}

enum ActivityType {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SENT
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_EXPORTED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  USER_LOGIN
  USER_REGISTER
}
