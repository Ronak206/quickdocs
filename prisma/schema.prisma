// QuickDocs - Professional Document Builder
// Prisma Schema for MongoDB
// Following SOLID Principles:
// - Single Responsibility: Each model has one purpose
// - Open/Closed: Enums allow extension without modification
// - Liskov Substitution: Interfaces through consistent relations
// - Interface Segregation: Models separated by domain
// - Dependency Inversion: Relations depend on abstractions (IDs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// Subscription Plans (Single Responsibility)
// ============================================

model Plan {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   @unique // FREE, STARTER, PRO, ENTERPRISE
  displayName       String   // Free, Starter, Pro, Enterprise
  description       String?
  price             Float    @default(0)
  currency          String   @default("USD")
  pdfLimit          Int      @default(10) // PDFs per month
  templateLimit     Int      @default(5) // Custom templates
  storageLimit      Int      @default(10) // MB
  features          String   // JSON array of feature strings
  isPopular         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  subscriptions     Subscription[]
}

model Subscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  planId          String   @db.ObjectId
  status          SubscriptionStatus @default(active)
  startDate       DateTime @default(now())
  endDate         DateTime? // null for active subscriptions
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  email         String     @unique
  name          String?
  password      String     // Hashed password for credentials auth
  company       String?
  logo          String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  taxId         String?
  website       String?
  avatar        String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  documents     Document[]
  templates     Template[]
  activities    Activity[]
  usage         Usage[]
  downloads     Download[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Usage Tracking (Single Responsibility)
// ============================================

model Usage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  month           Int      // 1-12
  year           Int      // 2024, 2025, etc.
  pdfCount       Int      @default(0)
  storageUsed    Int      @default(0) // in bytes
  templatesUsed  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint for one usage record per user per month
  @@unique([userId, month, year])
}

// ============================================
// Template Models
// ============================================

model Template {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  category      TemplateCategory
  type          DocumentType
  schema        String           // JSON schema for form fields
  layout        String           // JSON layout definition
  styling       String?          // Custom CSS/styles
  preview       String?          // Preview image URL
  thumbnail     String?          // Thumbnail image URL
  isPublic      Boolean          @default(false)
  isPremium     Boolean          @default(false)
  isDefault     Boolean          @default(false)
  isSystem      Boolean          @default(false) // System templates cannot be deleted
  source        String?          // URL if from external source
  sourceName    String?          // Name of external source
  tags          String?          // Comma-separated tags
  version       Int              @default(1)
  downloads     Int              @default(0)
  uses          Int              @default(0) // Times used in documents
  rating        Float?           // Average rating
  ratingCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  creatorId     String?          @db.ObjectId
  creator       User?            @relation(fields: [creatorId], references: [id])
  documents     Document[]
  fields        TemplateField[]
}

model TemplateField {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  templateId    String        @db.ObjectId
  template      Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  label         String
  type          FieldType
  required      Boolean       @default(false)
  defaultValue  String?
  placeholder   String?
  helpText      String?
  options       String?       // JSON for select/radio options
  validation    String?       // Validation rules
  order         Int           @default(0)
  group         String?       // Field group name
  width         String?       // Field width (full, half, third)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============================================
// Document Models (with PDF compression)
// ============================================

model Document {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  documentNumber String?
  type           DocumentType
  data           String          // JSON document data (compressed)
  dataHash       String?         // Hash for deduplication
  compressedSize Int?            // Size in bytes after compression
  templateId     String?         @db.ObjectId
  template       Template?       @relation(fields: [templateId], references: [id])
  ownerId        String          @db.ObjectId
  owner          User            @relation(fields: [ownerId], references: [id])
  status         DocumentStatus  @default(draft)

  // PDF Storage (compressed)
  pdfData        String?         // Base64 encoded compressed PDF
  pdfUrl         String?         // External URL if stored elsewhere
  pdfSize        Int?            // Size in bytes
  pdfGeneratedAt DateTime?

  // Financial info
  totalAmount    Float?
  currency       String?         @default("USD")

  // Metadata
  validFrom      DateTime?
  validTo        DateTime?
  notes          String?
  tags           String?
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  items          DocumentItem[]
  history        DocumentHistory[]
  activities     Activity[]
}

model DocumentItem {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String     @db.ObjectId
  document      Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  quantity      Float      @default(1)
  unitPrice     Float      @default(0)
  total         Float      @default(0)
  taxRate       Float?     @default(0)
  taxAmount     Float?     @default(0)
  category      String?
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DocumentHistory {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String        @db.ObjectId
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action        String
  changes       String?       // JSON of changes made
  previousState String?       // JSON of previous state
  userId        String?       @db.ObjectId
  userName      String?
  createdAt     DateTime      @default(now())
}

// ============================================
// Activity & Analytics Models
// ============================================

model Activity {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  type          ActivityType
  description   String
  metadata      String?     // JSON additional data
  userId        String?     @db.ObjectId
  user          User?       @relation(fields: [userId], references: [id])
  documentId    String?     @db.ObjectId
  document      Document?   @relation(fields: [documentId], references: [id])
  createdAt     DateTime    @default(now())
}

// ============================================
// Enums (Open/Closed Principle)
// ============================================

enum SubscriptionStatus {
  active
  canceled
  expired
  past_due
  trialing
}

enum TemplateCategory {
  EXPENSE
  TENDER
  PROPOSAL
  SALARY
  INVOICE
  RECEIPT
  CONTRACT
  REPORT
  LETTER
  CERTIFICATE
  AGREEMENT
  QUOTE
  MEMO
  CUSTOM
}

enum DocumentType {
  EXPENSE_REPORT
  EXPENSE_CLAIM
  TRAVEL_EXPENSE
  MONTHLY_EXPENSE
  TENDER_DOCUMENT
  TENDER_PROPOSAL
  BID_DOCUMENT
  TENDER_EVALUATION
  RFP_DOCUMENT
  BUSINESS_PROPOSAL
  PROJECT_PROPOSAL
  SALES_PROPOSAL
  PARTNERSHIP_PROPOSAL
  GRANT_PROPOSAL
  SALARY_SLIP
  SALARY_CERTIFICATE
  PAYROLL_REPORT
  SALARY_INCREMENT
  OFFER_LETTER
  INVOICE
  PROFORMA_INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  CONTRACT
  AGREEMENT
  NDA
  SERVICE_AGREEMENT
  REPORT
  LETTER
  CERTIFICATE
  QUOTE
  MEMO
  CUSTOM
}

enum DocumentStatus {
  draft
  pending_review
  approved
  rejected
  sent
  paid
  overdue
  cancelled
  archived
}

enum FieldType {
  text
  number
  email
  phone
  date
  datetime
  textarea
  select
  radio
  checkbox
  currency
  percentage
  file
  image
  signature
  company
  address
}

// ============================================
// Downloads (User PDF Downloads Storage)
// ============================================

model Download {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String
  fileSize    Int
  pdfData     String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SENT
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_EXPORTED
  DOCUMENT_DOWNLOADED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  USER_LOGIN
  USER_REGISTER
  PLAN_UPGRADED
  PLAN_DOWNGRADED
}

// ============================================
// Payments (NOWPayments Integration)
// ============================================

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // NOWPayments data
  paymentId       String        @unique  // NOWPayments payment ID
  invoiceId       String?       // NOWPayments invoice ID if using invoices
  
  // Payment details
  orderId         String        // Internal order ID
  amount          Float         // Amount in USD
  payCurrency     String?       // Cryptocurrency used for payment
  payAmount       Float?        // Amount in cryptocurrency
  
  // Status tracking
  status          PaymentStatus @default(pending)
  paymentAddress  String?       // Crypto deposit address
  
  // Webhook data
  actuallyPaid    Float?        // Actually paid amount
  webhookData     String?       // JSON of last webhook payload
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?     // When payment was confirmed
}

enum PaymentStatus {
  pending
  waiting
  confirming
  confirmed
  sending
  partially_paid
  finished
  failed
  expired
  refunded
  cancelled
}
